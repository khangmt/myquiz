# Copy to infra/.env and fill in. Never commit the real file (SEC-25).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# A domain gives automatic HTTPS. Use ":80" when the faculty reverse proxy
# terminates TLS in front of Caddy.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# The address people type, without a trailing slash. Google sends people
# back to <PUBLIC_URL>/api/v1/auth/google/callback, so register exactly that
# as an authorized redirect URI on the OAuth client.
PUBLIC_URL=https://quiz.example.edu.vn

# Optional: the address players open, shown on the host screen. Defaults to
# PUBLIC_URL. For a test on a laptop, set it to the laptop's Wi-Fi address so
# phones can join, e.g. http://192.168.1.20:8080 (see README, "Playing on
# phones"). Players never sign in, so it needs no Google redirect URI.
# JOIN_URL=

# 32+ random characters, e.g. `openssl rand -hex 32`. Hashes IPs in the audit
# log and signs download links. Changing it invalidates open download links.
APP_SECRET=

# Google sign-in (Google Cloud console > APIs & Services > Credentials,
# "Web application" client). Without these, sign-in answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated, e.g. uit.edu.vn,gm.uit.edu.vn. Empty allows any verified
# Google account.
ALLOWED_EMAIL_DOMAINS=

# Keep true in production. Set false only when testing over plain http.
COOKIE_SECURE=true

RUST_LOG=info,sqlx=warn

# Quizzes are deleted this many days after the last edit or game. Shown in
# the editor and the quiz list as the date.
RETENTION_DAYS=21

# The daily clean-up (02:00 Vietnam time): reminder emails 7 days and 1 day
# before a quiz is deleted, deleting quizzes past their date, purging quizzes
# deleted by their owner 30 days ago, and reports older than 12 months.
# Set CLEANUP_ENABLED=false to pause all deleting.
CLEANUP_ENABLED=true
CLEANUP_HOUR=2
# Outgoing mail for the reminders. Leave empty to send none (the warnings in
# the app still show). Gmail example, with an app password:
#   SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=myquiz <no-reply@example.edu.vn>
# New games are refused above this many at once (NFR-03). 100 at launch;
# see docs/load-test.md before raising it.
MAX_ACTIVE_GAMES=100

# Nightly encrypted backups (README, "Backups"), switched on with
# `docker compose --profile backup up -d`. BACKUP_AGE_RECIPIENT is the
# PUBLIC key from `age-keygen` (age1...); never put the private key here.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=./backups
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
