# Copy to infra/.env and fill in. Never commit the real file (SEC-25).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# A domain gives automatic HTTPS. Use ":80" when the faculty reverse proxy
# terminates TLS in front of Caddy.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# The address people type, without a trailing slash. Google sends people
# back to <PUBLIC_URL>/api/v1/auth/google/callback, so register exactly that
# as an authorized redirect URI on the OAuth client.
PUBLIC_URL=https://quiz.example.edu.vn

# 32+ random characters, e.g. `openssl rand -hex 32`. Hashes IPs in the audit
# log and signs download links. Changing it invalidates open download links.
APP_SECRET=

# Google sign-in (Google Cloud console > APIs & Services > Credentials,
# "Web application" client). Without these, sign-in answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated, e.g. uit.edu.vn,gm.uit.edu.vn. Empty allows any verified
# Google account.
ALLOWED_EMAIL_DOMAINS=

# Keep true in production. Set false only when testing over plain http.
COOKIE_SECURE=true

RUST_LOG=info,sqlx=warn

# Quizzes are deleted this many days after the last edit or game (week 3
# job; nothing is deleted before then). Shown in the editor as the date.
RETENTION_DAYS=21
# New games are refused above this many at once (NFR-03).
MAX_ACTIVE_GAMES=200
