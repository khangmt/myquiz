# For running the servers directly with cargo against infra/docker-compose.dev.yml.
DATABASE_URL=postgres://myquiz:myquiz@localhost:5432/myquiz
REDIS_URL=redis://localhost:6379
BIND_ADDR=127.0.0.1:8080

# Sign-in during development. Use the Vite address so cookies and the
# redirect land on the same origin; register
# http://localhost:5173/api/v1/auth/google/callback on a test OAuth client.
PUBLIC_URL=http://localhost:5173
APP_SECRET=dev-only-secret-dev-only-secret-dev-only
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=
